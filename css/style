/* Voltara - katalog produk elektronik (tema terang/gelap lewat class .dark di <html>) */
:root{--bg:#edf1f5;--surface:#fff;--ink:#0f1b2d;--muted:#4a5a70;--line:#c5d0dc;--grid:rgba(23,71,196,.08);--primary:#1747c4;--on-primary:#fff;--panel:#1747c4;--accent:#f0a500;--focus:#e8590c}
:root.dark{--bg:#0a1226;--surface:#111c36;--ink:#e9eefb;--muted:#a3b2d1;--line:#25365d;--grid:rgba(120,160,255,.09);--primary:#6c97ff;--on-primary:#0a1226;--panel:#14338f;--focus:#ffb703}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{font-size:100%;scroll-behavior:smooth;scroll-padding-top:5rem}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6}
h1,h2,h3{font-family:Bahnschrift,"DIN Alternate","Franklin Gothic Medium","Arial Narrow",sans-serif;line-height:1.15;margin:0 0 .5rem}
a{color:var(--primary)}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.container{width:min(1100px,100% - 2rem);margin-inline:auto}

/* tombol */
.btn,.tab{font:inherit;cursor:pointer;border-radius:6px;border:1px solid var(--primary);padding:.45rem .9rem;background:transparent;color:var(--primary);text-decoration:none;display:inline-block}
.btn,.tab{transition:background .2s,color .2s,border-color .2s}
.btn:hover{background:var(--primary);color:var(--on-primary)}
.btn-solid:hover{filter:brightness(1.15)}
.btn-solid{background:var(--primary);color:var(--on-primary)}

/* header & navigasi */
.site-header{position:sticky;top:0;z-index:10;background:var(--surface);border-bottom:1px solid var(--line)}
.header-inner{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1rem;padding:.6rem 0}
.brand{display:flex;align-items:center;gap:.5rem;font:700 1.35rem Bahnschrift,"Arial Narrow",sans-serif;color:var(--ink);text-decoration:none;margin-right:auto}
.brand img{width:32px;height:32px}
.nav-menu ul{display:flex;gap:1.25rem;list-style:none;margin:0;padding:0}
.nav-menu a{color:var(--ink);text-decoration:none;padding:.25rem 0;border-bottom:2px solid transparent}
.nav-menu a{transition:color .2s,border-color .2s}
.nav-menu a:hover{color:var(--primary);border-color:var(--accent)}
.brand{transition:color .2s}
.brand:hover{color:var(--primary)}
.theme-switch{position:relative;display:flex;align-items:center;justify-content:space-between;width:62px;height:32px;padding:0 8px;border:1px solid var(--line);border-radius:999px;background:var(--bg);cursor:pointer;transition:border-color .2s,box-shadow .2s}
.theme-switch:hover{border-color:var(--primary);box-shadow:0 0 0 3px var(--grid)}
.theme-switch .thumb{position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:var(--primary);transition:transform .25s ease}
.theme-switch[aria-checked="true"] .thumb{transform:translateX(30px)}
.theme-switch .icon{position:relative;z-index:1;transition:color .2s}
.theme-switch .icon-sun{color:var(--on-primary)}
.theme-switch .icon-moon{color:var(--muted)}
.theme-switch[aria-checked="true"] .icon-sun{color:var(--muted)}
.theme-switch[aria-checked="true"] .icon-moon{color:var(--on-primary)}
.menu-toggle:hover{border-color:var(--primary)}
.menu-toggle{display:none;width:2.5rem;height:2.5rem;padding:0;border:1px solid var(--line);border-radius:6px;background:transparent;cursor:pointer}
.menu-toggle span{display:block;width:18px;height:2px;margin:4px auto;background:var(--ink)}

/* hero */
.hero{padding:4rem 0;border-bottom:1px solid var(--line);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px}
.hero h1{font-size:clamp(2.1rem,6vw,3.8rem);max-width:15ch}
.hero p{max-width:52ch;color:var(--muted);margin:0 0 1.5rem}

/* produk */
section{padding:3rem 0}
.toolbar{display:flex;flex-wrap:wrap;gap:1rem;align-items:end;margin:1rem 0 .5rem}
.field{display:flex;flex-direction:column;font-size:.9rem;color:var(--muted)}
.field input,.field select{font:inherit;padding:.5rem .7rem;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);min-width:220px}
.status{color:var(--muted);margin:0 0 1.25rem}
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1.5rem;align-items:stretch}
.product{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:4px;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease,border-color .25s}
.product:hover{border-color:var(--primary);box-shadow:0 10px 24px rgba(15,27,45,.18)}
.product:hover .product-media img{transform:scale(1.06)}
/* bingkai gambar seragam (16:10); foto berukuran apa pun dimuat utuh tanpa terpotong atau melar */
.product-media{aspect-ratio:16/10;background:#fff;border-bottom:1px solid var(--line);overflow:hidden}
.product-media img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .3s ease}
.product-body{display:flex;flex-direction:column;flex:1;padding:1rem 1.1rem 1.2rem}
.product-body h3{line-height:1.3;min-height:2.6em}
.product-body .btn-detail{align-self:flex-start}
.product-category{margin:0;font-size:.85rem;color:var(--muted)}
.product-price{font-weight:700;margin:0 0 .5rem}
.product-desc{flex:1;margin:0 0 1rem;color:var(--muted)}
.detail{margin-top:1rem;border-top:1px solid var(--line);padding-top:.9rem}
.tabs{display:flex;gap:.4rem;margin-bottom:.8rem}
.tab{padding:.3rem .8rem;font-size:.9rem;border-color:var(--line);color:var(--ink)}
.tab:hover{border-color:var(--primary);background:var(--grid);color:var(--ink)}
.tab.is-active{border-color:var(--accent);box-shadow:inset 0 -3px 0 var(--accent);font-weight:600}
table{width:100%;border-collapse:collapse;font-size:.92rem}
th,td{text-align:left;padding:.35rem .4rem .35rem 0;border-bottom:1px solid var(--line);vertical-align:top}
th{width:42%;color:var(--muted);font-weight:600}
.panel ul{margin:0;padding-left:1.1rem}
.empty{padding:2rem;border:1px dashed var(--line);text-align:center}
#tentang,#kontak{border-top:1px solid var(--line)}
#tentang ul{padding-left:1.1rem}
.site-footer{padding:1.5rem 0;border-top:1px solid var(--line);background:var(--surface);color:var(--muted);font-size:.9rem}
@media (prefers-reduced-motion:no-preference){.product:hover{transform:translateY(-4px)}.detail:not([hidden]){animation:buka .2s ease-out}@keyframes buka{from{opacity:0}to{opacity:1}}}

/* pengatur ukuran teks: knob potensiometer (satuan px agar panel tidak ikut membesar saat digeser) */
.text-size{position:fixed;right:16px;bottom:16px;z-index:20;display:flex;flex-direction:column;align-items:flex-end;gap:12px}
.size-knob{width:56px;height:56px;padding:0;border:0;border-radius:50%;background:var(--surface);cursor:pointer;box-shadow:0 4px 14px rgba(15,27,45,.28);transition:box-shadow .2s}
.size-knob:hover,.size-knob[aria-expanded="true"]{box-shadow:0 0 0 4px var(--grid),0 4px 14px rgba(15,27,45,.28)}
.size-knob svg{display:block}
.knob-ring{fill:var(--surface);stroke:var(--primary);stroke-width:3}
.knob-pointer{transform-origin:28px 28px;transform:rotate(var(--angle,-60deg))}
.knob-pointer line{stroke:var(--primary);stroke-width:3;stroke-linecap:round}
.knob-pointer circle{fill:var(--accent)}
.knob-cap{fill:var(--primary)}
.size-panel{width:248px;padding:14px 16px 12px;background:var(--surface);border:1px solid var(--line);border-radius:10px;box-shadow:0 10px 28px rgba(15,27,45,.28);font-size:14px;line-height:1.4}
.size-title{display:flex;justify-content:space-between;align-items:baseline;font-weight:600;margin-bottom:10px}
.size-title output{font:700 18px Bahnschrift,"Arial Narrow",sans-serif;color:var(--primary);min-width:4ch;text-align:right}
.size-track{position:relative;height:24px}
.size-ticks{position:absolute;inset:0 11px;display:flex;justify-content:space-between;align-items:center}
.size-ticks i{width:2px;height:14px;background:var(--line)}
.size-track input{position:absolute;inset:0;width:100%;margin:0;background:transparent;-webkit-appearance:none;appearance:none;cursor:pointer}
.size-track input::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:linear-gradient(90deg,var(--accent) var(--fill,25%),var(--line) var(--fill,25%))}
.size-track input::-moz-range-track{height:6px;border-radius:3px;background:linear-gradient(90deg,var(--accent) var(--fill,25%),var(--line) var(--fill,25%))}
.size-track input::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;margin-top:-8px;border-radius:50%;background:var(--primary);border:4px solid var(--surface);box-shadow:0 0 0 2px var(--primary)}
.size-track input::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--primary);border:4px solid var(--surface);box-shadow:0 0 0 2px var(--primary)}
.size-scale{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;margin-top:4px}
.site-footer .container{padding-right:72px}
@media (prefers-reduced-motion:no-preference){.knob-pointer{transition:transform .3s cubic-bezier(.3,1.4,.5,1)}.size-panel:not([hidden]){animation:buka .2s ease-out}}

/* responsif: tablet & smartphone */
@media (max-width:768px){
  .menu-toggle{display:block;order:2}
  .theme-switch{order:1}
  .nav-menu{display:none;flex-basis:100%;order:5}
  .nav-menu.is-open{display:block}
  .nav-menu ul{flex-direction:column;gap:.25rem}
  .hero{padding:2.5rem 0}
  .field,.field input,.field select{width:100%;min-width:0}
}
